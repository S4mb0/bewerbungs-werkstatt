{#- Anschreiben zum Grundlayout „kopfband“: dasselbe farbige Band oben über die volle Breite mit Name, Untertitel und
    Kontakt (ohne Foto), darunter der Briefbogen mit Rändern nach DIN 5008 (links 25 mm, rechts 20 mm).
    Text im Band ist weiß; den Kontrast der Farbe prüft render.py wie beim Lebenslauf. -#}
{%- import "_abschnitte.html.j2" as A -%}
{%- import "_brief.html.j2" as B with context -%}
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<title>Anschreiben {{ person.name }}</title>
<style>
  {{- A.schriften(stil) }}
  @page { size: A4; margin: 12mm 0 12mm; }
  @page :first { margin-top: 0; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: {{ stil.schrift.stack | safe }}; color: #222; font-size: 10.5pt; line-height: 1.42; }
  @media screen {
    body { background: #e9ecef; }
    .page { width: 210mm; min-height: 297mm; margin: 8mm auto; padding: 0 0 12mm; background: #fff; box-shadow: 0 1px 6px rgba(0,0,0,.15); }
  }
  .page { --acc: {{ stil.farbe }}; --line: {{ stil.linienfarbe }}; }
  header { background: var(--acc); color: #fff; padding: 9mm 20mm 6mm 25mm; line-height: 1.28;
           -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  h1 { margin: 0; font-size: 22pt; font-weight: 600; line-height: 1.1; }
  {#- Keine opacity für Text: Chrome legt ihn sonst in eine eigene Ebene, und ATS lesen ihn erst am Seitenende. #}
  .sub { margin: 1mm 0 2mm; font-size: 11pt; color: {{ stil.auf_farbe_hell }}; }
  .contact { font-size: 9.2pt; }
  .contact span { white-space: nowrap; }   /* Umbruch nur zwischen den Angaben, nie in der Telefonnummer */
  .contact span + span::before { content: "·"; margin: 0 2.2mm; color: {{ stil.auf_farbe_gedaempft }}; }
  .inhalt { padding: 9mm 20mm 0 25mm; }
  {{- B.stil() }}
</style>
</head>
<body>
<div class="page">
  <header>
    <h1>{{ person.name }}</h1>
    {%- if untertitel %}<p class="sub">{{ untertitel }}</p>{% endif %}
    <p class="contact">{% for k in person.kontakt_zeile %}<span>{{ k }}</span>{% endfor %}</p>
  </header>
  <div class="inhalt">
    {{- B.brief() }}
  </div>
</div>
</body>
</html>
