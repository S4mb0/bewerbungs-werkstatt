{#- Die Hauptabschnitte als Makros, gemeinsam für alle Grundlayouts.
    Ein Grundlayout ruft sie über abschnitt(name) in der Reihenfolge des Templates (stil.reihenfolge) auf.
    data-quelle / data-umformuliert sind unsichtbar und erscheinen nicht im PDF. -#}

{%- macro berufserfahrung_(berufserfahrung) %}
  {%- if berufserfahrung %}
  <h2>Berufserfahrung</h2>
  {%- for b in berufserfahrung %}
  <div class="entry" data-quelle="{{ b.quelle }}">
    <div class="head"><span class="title">{{ b.titel }}</span><span class="date">{{ b.zeitraum }}</span></div>
    <div class="org">{{ b.organisation }}{% if b.zuvor %} · zuvor {{ b.zuvor }}{% endif %}</div>
    {%- if b.taetigkeiten %}
    <ul>
      {%- for t in b.taetigkeiten %}
      <li data-quelle="{{ t.quelle }}"{% if t.umformuliert %} data-umformuliert="ja"{% endif %}>{{ t.text | auszeichnung }}</li>
      {%- endfor %}
    </ul>
    {%- endif %}
  </div>
  {%- endfor %}
  {%- endif %}
{%- endmacro %}

{%- macro ausbildung_(abschluesse) %}
  {%- if abschluesse %}
  <h2>Ausbildung &amp; Zertifizierung</h2>
  {%- for a in abschluesse %}
  <div class="entry" data-quelle="{{ a.quelle }}">
    <div class="head"><span><span class="title">{{ a.titel }}</span> <span class="org">· {{ a.institution }}</span></span><span class="date">{{ a.zeitraum }}</span></div>
  </div>
  {%- endfor %}
  {%- endif %}
{%- endmacro %}

{%- macro kenntnisse_(kenntnisse, sprachen, sprachen_titel="Sprachen") %}
  {%- if kenntnisse or sprachen %}
  <h2>Kenntnisse</h2>
  <dl>
    {%- for gruppe in kenntnisse %}
    <dt>{{ gruppe.kategorie }}</dt>
    <dd>{% for s in gruppe.skills %}<span data-quelle="{{ s.quelle }}">{{ s.name }}</span>{% if not loop.last %}, {% endif %}{% endfor %}</dd>
    {%- endfor %}
    {%- if sprachen %}
    <dt>{{ sprachen_titel }}</dt>
    <dd>{% for s in sprachen %}<span data-quelle="{{ s.quelle }}">{{ s.name }} ({{ s.niveau }})</span>{% if not loop.last %}, {% endif %}{% endfor %}</dd>
    {%- endif %}
  </dl>
  {%- endif %}
{%- endmacro %}

{%- macro projekte_(projekte) %}
  {%- if projekte %}
  <h2>Projekte</h2>
  {%- for p in projekte %}
  <div class="entry" data-quelle="{{ p.quelle }}"{% if p.umformuliert %} data-umformuliert="ja"{% endif %}><span class="title">{{ p.titel }}</span>{% if p.zeitraum %} <span class="date">({{ p.zeitraum }})</span>{% endif %} – {{ p.text | auszeichnung }}</div>
  {%- endfor %}
  {%- endif %}
{%- endmacro %}

{#- Schriften aus dem Repo (@font-face); Systemschriften brauchen keinen Eintrag. -#}
{%- macro schriften(stil) %}
  {%- for f in stil.schrift.dateien %}
  @font-face { font-family: "{{ stil.schrift.name }}"; src: url("{{ f.uri }}"); font-weight: {{ f.gewicht }}; font-style: {{ f.stil }}; }
  {%- endfor %}
{%- endmacro %}

{#- Einen Abschnitt über seinen Namen ausgeben. Braucht den Kontext: import "_abschnitte.html.j2" as A with context. -#}
{%- macro abschnitt(name) %}
  {%- if name == "berufserfahrung" %}{{ berufserfahrung_(berufserfahrung) }}
  {%- elif name == "ausbildung" %}{{ ausbildung_(abschluesse) }}
  {%- elif name == "kenntnisse" %}{{ kenntnisse_(kenntnisse, sprachen, sprachen_titel) }}
  {%- elif name == "projekte" %}{{ projekte_(projekte) }}
  {%- endif %}
{%- endmacro %}
