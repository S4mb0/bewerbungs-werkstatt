{#- Grundlayout „klassisch“: einspaltig, Foto im Kopf, Profil im Kopf neben dem Foto.
    Bekommt von render.py nur fertig aufbereitete Daten (siehe baue_kontext in render.py) und die Template-Parameter in `stil`.
    Die Parameter kommen aus dem Template (templates/klassisch.yaml oder ein eigenes). -#}
{%- import "_abschnitte.html.j2" as A -%}
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<title>Lebenslauf {{ person.name }}</title>
<style>
  {{- A.schriften(stil) }}
  @page { size: A4; margin: 11mm 12mm 9mm; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: {{ stil.schrift.stack | safe }}; color: #222; font-size: 9.2pt; line-height: 1.28; }
  @media screen {
    body { background: #e9ecef; }
    .page { width: 210mm; min-height: 297mm; margin: 8mm auto; padding: 11mm 12mm 9mm; background: #fff; box-shadow: 0 1px 6px rgba(0,0,0,.15); }
  }
  p { margin: 0; } ul { margin: 1mm 0 0; padding-left: 4.5mm; } li { margin: .2mm 0; break-inside: avoid; }
  .muted { color: #5a5a5a; }

  .page { --acc: {{ stil.farbe }}; --line: {{ stil.linienfarbe }}; }
  header { display: flex; justify-content: space-between; gap: 8mm; border-bottom: 2px solid var(--acc); padding-bottom: 3mm; }
  {%- if stil.foto.position == "links" %}
  header { flex-direction: row-reverse; }
  {%- endif %}
  header > div { flex: 1; min-width: 0; }
  h1 { margin: 0; font-size: 20pt; font-weight: 600; color: var(--acc); }
  .sub { margin: .5mm 0 1.5mm; font-size: 11pt; color: #5a5a5a; }
  .contact span + span::before { content: "·"; margin: 0 2.2mm; color: var(--line); }
  .profil { margin-top: 2mm; }
  .photo { width: 27mm; height: 36mm; object-fit: cover; flex: none; }
  {%- if stil.foto.form == "rund" %}
  .photo { width: 34mm; height: 34mm; border-radius: 50%; object-position: 50% 15%; }
  {%- endif %}
  h2 { font-size: 10.5pt; color: var(--acc); text-transform: uppercase; letter-spacing: 1px; margin: 3mm 0 1.6mm; padding-bottom: .8mm; border-bottom: 1px solid var(--line); break-after: avoid; }
  {%- if stil.ueberschriften == "balken" %}
  h2 { border-bottom: none; border-left: 2.5pt solid var(--acc); padding: .3mm 0 .3mm 2mm; }
  {%- elif stil.ueberschriften == "fett" %}
  h2 { border-bottom: none; padding-bottom: 0; }
  {%- endif %}
  .entry { margin-bottom: 1.6mm; break-inside: avoid; }
  .head { display: flex; justify-content: space-between; gap: 4mm; }
  .title { font-weight: 600; } .date { color: #5a5a5a; white-space: nowrap; } .org { color: #5a5a5a; font-style: italic; }
  dl { display: grid; grid-template-columns: 32mm 1fr; row-gap: .8mm; column-gap: 4mm; margin: 0; }
  dt { font-weight: 600; } dd { margin: 0; }
</style>
</head>
<body>
<div class="page">
  <header>
    <div>
      <h1>{{ person.name }}</h1>
      {%- if untertitel %}<p class="sub">{{ untertitel }}</p>{% endif %}
      <p class="contact muted">{% for k in person.kontakt %}<span>{{ k }}</span>{% endfor %}</p>
      {%- if profil %}
      <p class="profil" data-quelle="{{ profil.quelle }}"{% if profil.umformuliert %} data-umformuliert="ja"{% endif %}>{{ profil.text | auszeichnung }}</p>
      {%- endif %}
    </div>
    {%- if foto %}<img class="photo" src="{{ foto }}" alt="Bewerbungsfoto">{% endif %}
  </header>

  {%- for name in stil.reihenfolge %}
  {%- if name == "berufserfahrung" %}{{ A.berufserfahrung_(berufserfahrung) }}
  {%- elif name == "ausbildung" %}{{ A.ausbildung_(abschluesse) }}
  {%- elif name == "kenntnisse" %}{{ A.kenntnisse_(kenntnisse, sprachen, sprachen_titel) }}
  {%- elif name == "projekte" %}{{ A.projekte_(projekte) }}
  {%- endif %}
  {%- endfor %}
</div>
</body>
</html>
