{#- Anschreiben zum Grundlayout „zwei-spalten“: Hauptspalte mit Name, Untertitel und Briefbogen, schmale getönte
    Seitenleiste mit Absender und Kontakt (ohne Foto). Wie im Lebenslauf steht die Hauptspalte im HTML zuerst, und
    stil.foto.position wählt die Seite der Seitenleiste. Der Brieftext steht immer einspaltig in der Hauptspalte. -#}
{%- import "_abschnitte.html.j2" as A -%}
{%- import "_brief.html.j2" as B with context -%}
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<title>Anschreiben {{ person.name }}</title>
<style>
  {{- A.schriften(stil) }}
  @page { size: A4; margin: 12mm 14mm 12mm; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: {{ stil.schrift.stack | safe }}; color: #222; font-size: 10.2pt; line-height: 1.4; }
  @media screen {
    body { background: #e9ecef; }
    .page { width: 210mm; min-height: 297mm; margin: 8mm auto; padding: 12mm 14mm; background: #fff; box-shadow: 0 1px 6px rgba(0,0,0,.15); }
  }
  .page { --acc: {{ stil.farbe }}; --line: {{ stil.linienfarbe }}; --flaeche: {{ stil.flaeche }}; }
  .raster { display: grid; grid-template-columns: {% if stil.foto.position == "rechts" %}1fr 54mm{% else %}54mm 1fr{% endif %}; column-gap: 7mm; align-items: start; }
  main { grid-column: {% if stil.foto.position == "rechts" %}1{% else %}2{% endif %}; grid-row: 1; min-width: 0; }
  aside { grid-column: {% if stil.foto.position == "rechts" %}2{% else %}1{% endif %}; grid-row: 1; min-width: 0;
          background: var(--flaeche); padding: 4mm; font-size: 9pt; line-height: 1.3;
          -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  h1 { margin: 0; font-size: 21pt; font-weight: 600; line-height: 1.1; color: var(--acc); }
  .sub { margin: 1mm 0 0; font-size: 11pt; color: #5a5a5a; line-height: 1.28; }
  .kopf { padding-bottom: 2.5mm; border-bottom: 2px solid var(--acc); margin-bottom: 8mm; }
  h2 { font-size: 9.6pt; color: var(--acc); text-transform: uppercase; letter-spacing: 1px; margin: 0 0 1.6mm; padding-bottom: .8mm; border-bottom: 1px solid var(--line); }
  {%- if stil.ueberschriften == "balken" %}
  h2 { border-bottom: none; border-left: 2.5pt solid var(--acc); padding: .3mm 0 .3mm 2mm; }
  {%- elif stil.ueberschriften == "fett" %}
  h2 { border-bottom: none; padding-bottom: 0; }
  {%- endif %}
  aside p { margin-bottom: .8mm; overflow-wrap: anywhere; }
  aside .block + .block { margin-top: 2.5mm; }
  {{- B.stil() }}
</style>
</head>
<body>
<div class="page">
  <div class="raster">
    <main>
      <div class="kopf">
        <h1>{{ person.name }}</h1>
        {%- if untertitel %}<p class="sub">{{ untertitel }}</p>{% endif %}
      </div>
      {{- B.brief() }}
    </main>
    <aside>
      <h2>Kontakt</h2>
      <div class="block">{% for z in person.adresse %}<p>{{ z }}</p>{% endfor %}</div>
      <div class="block">{% for k in person.kontakt %}<p>{{ k }}</p>{% endfor %}</div>
    </aside>
  </div>
</div>
</body>
</html>
